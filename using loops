include <stdio.h>

int main() {
    int i, j;
    
    for(i = 1; i <= 5; i++) {         // Loop for rows
        for(j = 1; j <= i; j++) {     // Loop for printing '8' in each row
            printf("8");
        }
        printf("\n");                 // Move to the next line
    }
    
    return 0;
}
